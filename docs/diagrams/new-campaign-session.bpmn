<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Tablelog_NewCampaign" targetNamespace="https://tablelog.local/documentation/bpmn" exporter="Tablelog documentation" exporterVersion="1.0">
  <bpmn:process id="Process_Main" name="WF-CS-02 · Add a session to a new campaign" isExecutable="false">
    <bpmn:documentation>Model version 0.1, approved by the owner on 29 October 2026 within its stated scope and recovery boundary. BPMN overview: agreed intended behavior using an existing game system. Q-CS-04–05; FR-CS-20–24; AC-CS-24–30; shared criteria. Open recovery details: GAP-CS-01 / FU-SH-02. Implementation and runtime verification remain separate.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start_Main</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enter_Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Tablelog">
        <bpmn:flowNodeRef>Validate_Both</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid_Both</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Validation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save_Pair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pair_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refresh_Views</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refresh_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Unresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unresolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Main" name="Start">
      <bpmn:outgoing>M01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Open_Form" name="Open Add session / Choose New campaign">
      <bpmn:incoming>M01</bpmn:incoming>
      <bpmn:outgoing>M02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Enter_Details" name="Enter campaign defaults / and first-session details / Choose an existing system">
      <bpmn:incoming>M02</bpmn:incoming>
      <bpmn:outgoing>M03</bpmn:outgoing>
      <bpmn:incoming>M09</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Choose_Action" name="Save or cancel?" gatewayDirection="Diverging">
      <bpmn:incoming>M03</bpmn:incoming>
      <bpmn:outgoing>M04</bpmn:outgoing>
      <bpmn:outgoing>M06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Cancel_Form" name="Close without saving / Discard unsaved values">
      <bpmn:incoming>M04</bpmn:incoming>
      <bpmn:outgoing>M05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Cancelled" name="Cancelled / No writes">
      <bpmn:incoming>M05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Validate_Both" name="Validate both records / Derive effective defaults">
      <bpmn:incoming>M06</bpmn:incoming>
      <bpmn:outgoing>M07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid_Both" name="Both records valid?" gatewayDirection="Diverging">
      <bpmn:incoming>M07</bpmn:incoming>
      <bpmn:outgoing>M08</bpmn:outgoing>
      <bpmn:outgoing>M10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Show_Validation" name="Explain validation errors / Retain entered values">
      <bpmn:incoming>M08</bpmn:incoming>
      <bpmn:outgoing>M09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="Save_Pair" name="Save new campaign / and its first session / See saving / rollback detail" calledElement="Process_SavePair">
      <bpmn:incoming>M10</bpmn:incoming>
      <bpmn:outgoing>M11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Pair_Result" name="Save result?" gatewayDirection="Diverging">
      <bpmn:incoming>M11</bpmn:incoming>
      <bpmn:outgoing>M12</bpmn:outgoing>
      <bpmn:outgoing>M13</bpmn:outgoing>
      <bpmn:outgoing>M14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Refresh_Views" name="Refresh campaign choices, / calendar, history and stats">
      <bpmn:incoming>M12</bpmn:incoming>
      <bpmn:outgoing>M15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Refresh_Result" name="Refresh succeeded?" gatewayDirection="Diverging">
      <bpmn:incoming>M15</bpmn:incoming>
      <bpmn:outgoing>M16</bpmn:outgoing>
      <bpmn:outgoing>M18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Show_Success" name="Close form / Show completion">
      <bpmn:incoming>M16</bpmn:incoming>
      <bpmn:outgoing>M17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Success" name="Campaign + session saved / Views refreshed">
      <bpmn:incoming>M17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Show_Stale" name="Report both records saved / Explain view is outdated / Refresh only; never resave">
      <bpmn:incoming>M18</bpmn:incoming>
      <bpmn:outgoing>M19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Stale" name="Both records saved / View recovery required">
      <bpmn:incoming>M19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Show_Failure" name="Explain confirmed failure / Confirm cleanup status / Retain entered values">
      <bpmn:incoming>M13</bpmn:incoming>
      <bpmn:outgoing>M20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Failure" name="No saved pair / Correction / retry available">
      <bpmn:incoming>M20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Show_Unresolved" name="Explain known state / or uncertainty / Retain entered values">
      <bpmn:incoming>M14</bpmn:incoming>
      <bpmn:outgoing>M21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Unresolved" name="Recovery unresolved / Reconcile before retry">
      <bpmn:incoming>M21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="M01" sourceRef="Start_Main" targetRef="Open_Form" />
    <bpmn:sequenceFlow id="M02" sourceRef="Open_Form" targetRef="Enter_Details" />
    <bpmn:sequenceFlow id="M03" sourceRef="Enter_Details" targetRef="Choose_Action" />
    <bpmn:sequenceFlow id="M04" sourceRef="Choose_Action" targetRef="Cancel_Form" name="Cancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Cancel</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M05" sourceRef="Cancel_Form" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="M06" sourceRef="Choose_Action" targetRef="Validate_Both" name="Save">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Save</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M07" sourceRef="Validate_Both" targetRef="Valid_Both" />
    <bpmn:sequenceFlow id="M08" sourceRef="Valid_Both" targetRef="Show_Validation" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M09" sourceRef="Show_Validation" targetRef="Enter_Details" name="Correct" />
    <bpmn:sequenceFlow id="M10" sourceRef="Valid_Both" targetRef="Save_Pair" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M11" sourceRef="Save_Pair" targetRef="Pair_Result" />
    <bpmn:sequenceFlow id="M12" sourceRef="Pair_Result" targetRef="Refresh_Views" name="Both saved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Both saved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M13" sourceRef="Pair_Result" targetRef="Show_Failure" name="Confirmed failure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Confirmed failure</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M14" sourceRef="Pair_Result" targetRef="Show_Unresolved" name="Recovery unresolved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Recovery unresolved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M15" sourceRef="Refresh_Views" targetRef="Refresh_Result" />
    <bpmn:sequenceFlow id="M16" sourceRef="Refresh_Result" targetRef="Show_Success" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M17" sourceRef="Show_Success" targetRef="End_Success" />
    <bpmn:sequenceFlow id="M18" sourceRef="Refresh_Result" targetRef="Show_Stale" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M19" sourceRef="Show_Stale" targetRef="End_Stale" />
    <bpmn:sequenceFlow id="M20" sourceRef="Show_Failure" targetRef="End_Failure" />
    <bpmn:sequenceFlow id="M21" sourceRef="Show_Unresolved" targetRef="End_Unresolved" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Main">
    <bpmn:participant id="Participant_Main" name="Add first session to a new campaign" processRef="Process_Main" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SavePair" name="WF-CS-02 · Saving and rollback detail" isExecutable="false">
    <bpmn:documentation>Model version 0.1, approved by the owner on 29 October 2026 within its stated scope and recovery boundary. Called BPMN process with intended saving and rollback outcomes. Q-CS-04–05; FR-CS-20–24; AC-CS-24–30; shared criteria. Open recovery details: GAP-CS-01 / FU-SH-02. Implementation and runtime verification remain separate.</bpmn:documentation>
    <bpmn:startEvent id="Start_Pair" name="Start save attempt">
      <bpmn:outgoing>D01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Create_Campaign" name="Derive campaign defaults / Create new campaign">
      <bpmn:incoming>D01</bpmn:incoming>
      <bpmn:outgoing>D02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Campaign_Result" name="Campaign result?" gatewayDirection="Diverging">
      <bpmn:incoming>D02</bpmn:incoming>
      <bpmn:outgoing>D03</bpmn:outgoing>
      <bpmn:outgoing>D04</bpmn:outgoing>
      <bpmn:outgoing>D06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Create_Session" name="Create first session / Link to confirmed campaign ID">
      <bpmn:incoming>D03</bpmn:incoming>
      <bpmn:outgoing>D07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Session_Result" name="Session result?" gatewayDirection="Diverging">
      <bpmn:incoming>D07</bpmn:incoming>
      <bpmn:outgoing>D08</bpmn:outgoing>
      <bpmn:outgoing>D09</bpmn:outgoing>
      <bpmn:outgoing>D10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Pair_Saved" name="Both records / confirmed saved">
      <bpmn:incoming>D08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Campaign_Rejected" name="Keep entered values / Explain campaign rejection">
      <bpmn:incoming>D04</bpmn:incoming>
      <bpmn:outgoing>D05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Campaign_Rejected" name="Confirmed failure / No campaign created">
      <bpmn:incoming>D05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Rollback_Campaign" name="Remove only the campaign / created by this attempt">
      <bpmn:incoming>D09</bpmn:incoming>
      <bpmn:outgoing>D11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Rollback_Result" name="Rollback confirmed?" gatewayDirection="Diverging">
      <bpmn:incoming>D11</bpmn:incoming>
      <bpmn:outgoing>D12</bpmn:outgoing>
      <bpmn:outgoing>D14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Report_Rollback" name="Confirm failed session save / and campaign removal / Keep entered values">
      <bpmn:incoming>D12</bpmn:incoming>
      <bpmn:outgoing>D13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Rolled_Back" name="First session unsaved / Campaign removed">
      <bpmn:incoming>D13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_Recovery" name="Alternative recovery paths" gatewayDirection="Converging">
      <bpmn:incoming>D06</bpmn:incoming>
      <bpmn:incoming>D10</bpmn:incoming>
      <bpmn:incoming>D14</bpmn:incoming>
      <bpmn:outgoing>D15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Report_Recovery" name="Report recovery required / Keep entered values / No automatic retry">
      <bpmn:incoming>D15</bpmn:incoming>
      <bpmn:outgoing>D16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Pair_Unresolved" name="Recovery unresolved / Return known state / uncertainty">
      <bpmn:incoming>D16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D01" sourceRef="Start_Pair" targetRef="Create_Campaign" />
    <bpmn:sequenceFlow id="D02" sourceRef="Create_Campaign" targetRef="Campaign_Result" />
    <bpmn:sequenceFlow id="D03" sourceRef="Campaign_Result" targetRef="Create_Session" name="Saved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Saved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D04" sourceRef="Campaign_Result" targetRef="Campaign_Rejected" name="Confirmed rejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Confirmed rejection</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D05" sourceRef="Campaign_Rejected" targetRef="End_Campaign_Rejected" />
    <bpmn:sequenceFlow id="D06" sourceRef="Campaign_Result" targetRef="Merge_Recovery" name="Outcome unknown">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Outcome unknown</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D07" sourceRef="Create_Session" targetRef="Session_Result" />
    <bpmn:sequenceFlow id="D08" sourceRef="Session_Result" targetRef="End_Pair_Saved" name="Saved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Saved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D09" sourceRef="Session_Result" targetRef="Rollback_Campaign" name="Confirmed unsaved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Confirmed unsaved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D10" sourceRef="Session_Result" targetRef="Merge_Recovery" name="Outcome unknown">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Outcome unknown</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D11" sourceRef="Rollback_Campaign" targetRef="Rollback_Result" />
    <bpmn:sequenceFlow id="D12" sourceRef="Rollback_Result" targetRef="Report_Rollback" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D13" sourceRef="Report_Rollback" targetRef="End_Rolled_Back" />
    <bpmn:sequenceFlow id="D14" sourceRef="Rollback_Result" targetRef="Merge_Recovery" name="Rejected / unknown">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Rejected / unknown</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D15" sourceRef="Merge_Recovery" targetRef="Report_Recovery" />
    <bpmn:sequenceFlow id="D16" sourceRef="Report_Recovery" targetRef="End_Pair_Unresolved" />
    <bpmn:textAnnotation id="Annotation_Defaults">
      <bpmn:text>Q-CS-05: retain explicit default GM; otherwise use session GM. Use the first session system and optional link as campaign defaults.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Recovery">
      <bpmn:text>GAP-CS-01 / FU-SH-02: a lost response proves neither success nor failure. Identify and reconcile this creation attempt before retry or cleanup claims. Detailed mechanism and interaction remain open.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Pair">
    <bpmn:participant id="Participant_Pair" name="Tablelog — save campaign and first session" processRef="Process_SavePair" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Main" name="WF-CS-02 · Add a session to a new campaign">
    <bpmndi:BPMNPlane id="Plane_Main" bpmnElement="Collaboration_Main">
      <bpmndi:BPMNShape id="Participant_Main_di" bpmnElement="Participant_Main" isHorizontal="true">
        <dc:Bounds x="30" y="160" width="1780" height="1050" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="160" width="1750" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_App_di" bpmnElement="Lane_App" isHorizontal="true">
        <dc:Bounds x="60" y="420" width="1750" height="790" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Main_di" bpmnElement="Start_Main">
        <dc:Bounds x="120" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-7.0" y="305" width="290" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Open_Form_di" bpmnElement="Open_Form">
        <dc:Bounds x="210" y="240" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Enter_Details_di" bpmnElement="Enter_Details">
        <dc:Bounds x="520" y="240" width="300" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Choose_Action_di" bpmnElement="Choose_Action" isMarkerVisible="true">
        <dc:Bounds x="900" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="202" width="290" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cancel_Form_di" bpmnElement="Cancel_Form">
        <dc:Bounds x="1040" y="240" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled">
        <dc:Bounds x="1322" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1195.0" y="305" width="290" height="46" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_Both_di" bpmnElement="Validate_Both">
        <dc:Bounds x="800" y="500" width="250" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_Both_di" bpmnElement="Valid_Both" isMarkerVisible="true">
        <dc:Bounds x="1100" y="520" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="980" y="467" width="290" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Show_Validation_di" bpmnElement="Show_Validation">
        <dc:Bounds x="500" y="500" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Save_Pair_di" bpmnElement="Save_Pair" isExpanded="false">
        <dc:Bounds x="1260" y="480" width="290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pair_Result_di" bpmnElement="Pair_Result" isMarkerVisible="true">
        <dc:Bounds x="1380" y="690" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1335" y="642" width="290" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Refresh_Views_di" bpmnElement="Refresh_Views">
        <dc:Bounds x="1010" y="670" width="260" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Refresh_Result_di" bpmnElement="Refresh_Result" isMarkerVisible="true">
        <dc:Bounds x="875" y="690" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="755" y="632" width="290" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Show_Success_di" bpmnElement="Show_Success">
        <dc:Bounds x="500" y="670" width="270" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Success_di" bpmnElement="End_Success">
        <dc:Bounds x="412" y="697" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="786" width="290" height="46" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Show_Stale_di" bpmnElement="Show_Stale">
        <dc:Bounds x="750" y="900" width="290" height="90" />
      </bpmndi:BPMNShape>
