        <dc:Bounds x="750" y="900" width="290" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Stale_di" bpmnElement="End_Stale">
        <dc:Bounds x="877" y="1082" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750.0" y="1125" width="290" height="46" />
        </bpmndi:BPMNLabel>
