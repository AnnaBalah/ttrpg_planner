        <bpmndi:BPMNLabel>
          <dc:Bounds x="1260.0" y="1125" width="290" height="46" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Show_Unresolved_di" bpmnElement="Show_Unresolved">
        <dc:Bounds x="1530" y="860" width="240" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Unresolved_di" bpmnElement="End_Unresolved">
        <dc:Bounds x="1632" y="1082" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1505.0" y="1125" width="290" height="46" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="M01_di" bpmnElement="M01">
        <di:waypoint x="156" y="280" />
        <di:waypoint x="210" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M02_di" bpmnElement="M02">
        <di:waypoint x="450" y="280" />
        <di:waypoint x="520" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M03_di" bpmnElement="M03">
        <di:waypoint x="820" y="280" />
        <di:waypoint x="900" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M04_di" bpmnElement="M04">
        <di:waypoint x="950" y="280" />
        <di:waypoint x="1040" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="910" y="241" width="170" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M05_di" bpmnElement="M05">
        <di:waypoint x="1280" y="280" />
        <di:waypoint x="1322" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M06_di" bpmnElement="M06">
        <di:waypoint x="925" y="305" />
        <di:waypoint x="925" y="500" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="872" y="372" width="170" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M07_di" bpmnElement="M07">
        <di:waypoint x="1050" y="545" />
        <di:waypoint x="1100" y="545" />
      </bpmndi:BPMNEdge>
