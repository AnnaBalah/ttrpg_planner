<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Tablelog_NewCampaign" targetNamespace="https://tablelog.local/documentation/bpmn" exporter="Tablelog documentation" exporterVersion="1.0">
  <bpmn:process id="Process_Main" name="WF-CS-02 · Add a session to a new campaign" isExecutable="false">
    <bpmn:documentation>Model version 0.2, aligned with Q-SH-01. Intended form-save behavior: one server transaction, close/reset after confirmed save failure or unknown results, refresh without repeating or undoing a confirmed save. FR-CS-20-24; AC-CS-24-30. Implementation and runtime verification remain open.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start_Main</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enter_Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Tablelog">
        <bpmn:flowNodeRef>Validate_Both</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid_Both</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Validation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save_Pair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pair_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refresh_Views</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refresh_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show_Unresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unresolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Main" name="Start">
      <bpmn:outgoing>M01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Open_Form" name="Open Add session / Choose New campaign">
      <bpmn:incoming>M01</bpmn:incoming>
      <bpmn:outgoing>M02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Enter_Details" name="Enter campaign defaults / and first-session details / Choose an existing system">
      <bpmn:incoming>M02</bpmn:incoming>
      <bpmn:outgoing>M03</bpmn:outgoing>
      <bpmn:incoming>M09</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Choose_Action" name="Save or cancel?" gatewayDirection="Diverging">
      <bpmn:incoming>M03</bpmn:incoming>
      <bpmn:outgoing>M04</bpmn:outgoing>
      <bpmn:outgoing>M06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Cancel_Form" name="Close without saving / Discard unsaved values">
      <bpmn:incoming>M04</bpmn:incoming>
      <bpmn:outgoing>M05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Cancelled" name="Cancelled / No writes">
      <bpmn:incoming>M05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Validate_Both" name="Validate both records / Derive effective defaults">
      <bpmn:incoming>M06</bpmn:incoming>
      <bpmn:outgoing>M07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid_Both" name="Both records valid?" gatewayDirection="Diverging">
      <bpmn:incoming>M07</bpmn:incoming>
      <bpmn:outgoing>M08</bpmn:outgoing>
      <bpmn:outgoing>M10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Show_Validation" name="Explain validation errors / Retain entered values">
      <bpmn:incoming>M08</bpmn:incoming>
      <bpmn:outgoing>M09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="Save_Pair" name="Save campaign + first session / One server transaction / See transaction detail" calledElement="Process_SavePair">
      <bpmn:incoming>M10</bpmn:incoming>
      <bpmn:outgoing>M11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Pair_Result" name="Save result?" gatewayDirection="Diverging">
      <bpmn:incoming>M11</bpmn:incoming>
      <bpmn:outgoing>M12</bpmn:outgoing>
      <bpmn:outgoing>M13</bpmn:outgoing>
      <bpmn:outgoing>M14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Refresh_Views" name="Close/reset the form / Refresh choices and views">
      <bpmn:incoming>M12</bpmn:incoming>
      <bpmn:outgoing>M15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Refresh_Result" name="Refresh succeeded?" gatewayDirection="Diverging">
      <bpmn:incoming>M15</bpmn:incoming>
      <bpmn:outgoing>M16</bpmn:outgoing>
      <bpmn:outgoing>M18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Show_Success" name="Show completion">
      <bpmn:incoming>M16</bpmn:incoming>
      <bpmn:outgoing>M17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Success" name="Campaign + session saved / Views refreshed">
      <bpmn:incoming>M17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Show_Stale" name="Report both records saved / Explain view is outdated / Refresh only; never resave">
      <bpmn:incoming>M18</bpmn:incoming>
      <bpmn:outgoing>M19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Stale" name="Both records saved / View recovery required">
      <bpmn:incoming>M19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Show_Failure" name="Close/reset; discard input / Show failure message / No changes were saved">
      <bpmn:incoming>M13</bpmn:incoming>
      <bpmn:outgoing>M20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Failure" name="Confirmed failure / No new pair remains">
      <bpmn:incoming>M20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Show_Unresolved" name="Close/reset; discard input / Report unknown result / Check history; no auto-retry">
      <bpmn:incoming>M14</bpmn:incoming>
      <bpmn:outgoing>M21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Unresolved" name="Outcome unknown / No automatic retry">
      <bpmn:incoming>M21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="M01" sourceRef="Start_Main" targetRef="Open_Form" />
    <bpmn:sequenceFlow id="M02" sourceRef="Open_Form" targetRef="Enter_Details" />
    <bpmn:sequenceFlow id="M03" sourceRef="Enter_Details" targetRef="Choose_Action" />
    <bpmn:sequenceFlow id="M04" sourceRef="Choose_Action" targetRef="Cancel_Form" name="Cancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Cancel</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M05" sourceRef="Cancel_Form" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="M06" sourceRef="Choose_Action" targetRef="Validate_Both" name="Save">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Save</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M07" sourceRef="Validate_Both" targetRef="Valid_Both" />
    <bpmn:sequenceFlow id="M08" sourceRef="Valid_Both" targetRef="Show_Validation" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M09" sourceRef="Show_Validation" targetRef="Enter_Details" name="Correct" />
    <bpmn:sequenceFlow id="M10" sourceRef="Valid_Both" targetRef="Save_Pair" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M11" sourceRef="Save_Pair" targetRef="Pair_Result" />
    <bpmn:sequenceFlow id="M12" sourceRef="Pair_Result" targetRef="Refresh_Views" name="Both saved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Both saved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M13" sourceRef="Pair_Result" targetRef="Show_Failure" name="Confirmed failure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Confirmed failure</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M14" sourceRef="Pair_Result" targetRef="Show_Unresolved" name="Unknown result">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Unknown result</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M15" sourceRef="Refresh_Views" targetRef="Refresh_Result" />
    <bpmn:sequenceFlow id="M16" sourceRef="Refresh_Result" targetRef="Show_Success" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M17" sourceRef="Show_Success" targetRef="End_Success" />
    <bpmn:sequenceFlow id="M18" sourceRef="Refresh_Result" targetRef="Show_Stale" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M19" sourceRef="Show_Stale" targetRef="End_Stale" />
    <bpmn:sequenceFlow id="M20" sourceRef="Show_Failure" targetRef="End_Failure" />
    <bpmn:sequenceFlow id="M21" sourceRef="Show_Unresolved" targetRef="End_Unresolved" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Main">
    <bpmn:participant id="Participant_Main" name="Add first session to a new campaign" processRef="Process_Main" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SavePair" name="WF-CS-02 · One transaction for campaign and first session" isExecutable="false">
    <bpmn:documentation>Model version 0.2. One server transaction validates and saves all related changes. Commit together or roll back the attempt; preserve earlier records. Report confirmed commit, confirmed rollback, or unknown save/rollback result to the calling form. Q-SH-01; Q-CS-04-05; FR-CS-21-24; AC-CS-26-30. The browser never automatically repeats or undoes an unknown save.</bpmn:documentation>
    <bpmn:startEvent id="Start_Pair" name="Start save attempt">
      <bpmn:outgoing>D01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Validate_Pair" name="Validate both records / Derive campaign defaults">
      <bpmn:incoming>D01</bpmn:incoming>
      <bpmn:outgoing>D02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Save_Atomic_Pair" name="One server transaction / Save campaign + first session / Commit together or roll back">
      <bpmn:incoming>D02</bpmn:incoming>
      <bpmn:outgoing>D03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Atomic_Result" name="Transaction result?" gatewayDirection="Diverging">
      <bpmn:incoming>D03</bpmn:incoming>
      <bpmn:outgoing>D04</bpmn:outgoing>
      <bpmn:outgoing>D05</bpmn:outgoing>
      <bpmn:outgoing>D07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Pair_Saved" name="Both records saved">
      <bpmn:incoming>D04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Pair_Failure" name="Return confirmed failure / No new campaign or session / Earlier records unchanged">
      <bpmn:incoming>D05</bpmn:incoming>
      <bpmn:outgoing>D06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Pair_Failed" name="Confirmed failure / No partial changes">
      <bpmn:incoming>D06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Pair_Unknown" name="Return unknown save result / or unconfirmed rollback / Never automatically repeat or undo">
      <bpmn:incoming>D07</bpmn:incoming>
      <bpmn:outgoing>D08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Pair_Unknown" name="Outcome unknown / No cleanup-success claim">
      <bpmn:incoming>D08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D01" sourceRef="Start_Pair" targetRef="Validate_Pair" />
    <bpmn:sequenceFlow id="D02" sourceRef="Validate_Pair" targetRef="Save_Atomic_Pair" />
    <bpmn:sequenceFlow id="D03" sourceRef="Save_Atomic_Pair" targetRef="Atomic_Result" />
    <bpmn:sequenceFlow id="D04" sourceRef="Atomic_Result" targetRef="End_Pair_Saved" name="Commit confirmed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Commit confirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D05" sourceRef="Atomic_Result" targetRef="Pair_Failure" name="Rollback confirmed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Rollback confirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D06" sourceRef="Pair_Failure" targetRef="End_Pair_Failed" />
    <bpmn:sequenceFlow id="D07" sourceRef="Atomic_Result" targetRef="Pair_Unknown" name="Unknown result">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Unknown result</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="D08" sourceRef="Pair_Unknown" targetRef="End_Pair_Unknown" />
    <bpmn:textAnnotation id="Annotation_Defaults">
      <bpmn:text>Q-CS-05: explicit default GM takes precedence; otherwise use session GM. The first session system and optional link become campaign defaults.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Recovery">
      <bpmn:text>Q-SH-01: the calling form closes/resets after confirmed failure or an unknown result. Preserve earlier records. Never claim unchanged data or rollback without confirmation.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Pair">
    <bpmn:participant id="Participant_Pair" name="Tablelog — save campaign and first session" processRef="Process_SavePair" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Main" name="WF-CS-02 · Add a session to a new campaign">
    <bpmndi:BPMNPlane id="Plane_Main" bpmnElement="Collaboration_Main">
      <bpmndi:BPMNShape id="Participant_Main_di" bpmnElement="Participant_Main" isHorizontal="true">
        <dc:Bounds x="30" y="160" width="1780" height="1050" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="160" width="1750" height="260" />
