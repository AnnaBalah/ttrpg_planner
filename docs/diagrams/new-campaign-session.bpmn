      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_Both_di" bpmnElement="Validate_Both">
        <dc:Bounds x="800" y="500" width="250" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_Both_di" bpmnElement="Valid_Both" isMarkerVisible="true">
        <dc:Bounds x="1100" y="520" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="980" y="467" width="290" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Show_Validation_di" bpmnElement="Show_Validation">
        <dc:Bounds x="500" y="500" width="230" height="90" />
